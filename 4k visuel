def generer_svg_wallpaper(seed, palette, motif, largeur, hauteur):
"""Génère un wallpaper SVG procédural unique."""
random.seed(seed)
c = palette["couleurs"]
elements = []

# Background gradient
angle = random.randint(0, 360)
x1, y1 = 0, 0
x2, y2 = largeur, hauteur
if angle > 180:
y2 = 0
elements.append(
'<defs>'
f'<linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">'
f'<stop offset="0%" style="stop-color:{c[3]}"/>'
f'<stop offset="100%" style="stop-color:{c[0]}"/>'
'</linearGradient>'
f'<radialGradient id="rad" cx="50%" cy="50%" r="70%">'
f'<stop offset="0%" style="stop-color:{c[1]};stop-opacity:0.9"/>'
f'<stop offset="60%" style="stop-color:{c[2]};stop-opacity:0.4"/>'
f'<stop offset="100%" style="stop-color:{c[3]};stop-opacity:0"/>'
'</radialGradient>'
'</defs>'
)
elements.append(f'<rect width="{largeur}" height="{hauteur}" fill="url(#bg)"/>')

if motif == "gradient":
for i in range(8):
r = random.randint(200, 900)
cx = random.randint(0, largeur)
cy = random.randint(0, hauteur)
elements.append(
f'<circle cx="{cx}" cy="{cy}" r="{r}" '
f'fill="{c[i % 4]}" opacity="{random.uniform(0.1, 0.4):.2f}"/>'
)

elif motif == "radial":
elements.append(f'<rect width="{largeur}" height="{hauteur}" fill="url(#rad)"/>')
for i in range(20):
r = random.randint(10, 200)
cx = random.randint(0, largeur)
cy = random.randint(0, hauteur)
elements.append(
f'<circle cx="{cx}" cy="{cy}" r="{r}" fill="{c[i % 4]}" '
f'opacity="{random.uniform(0.05, 0.25):.2f}"/>'
)

elif motif == "waves":
for i in range(10):
path = f'M 0 {hauteur * i // 10} '
for x in range(0, largeur + 100, 100):
y = hauteur * i // 10 + random.randint(-80, 80)
path += f'Q {x + 50} {y - 40}, {x + 100} {y} '
elements.append(
f'<path d="{path}" fill="none" stroke="{c[i % 4]}" '
f'stroke-width="{random.randint(2, 8)}" '
f'opacity="{random.uniform(0.2, 0.5):.2f}"/>'
)

elif motif == "grid":
spacing = random.randint(40, 100)
for x in range(0, largeur, spacing):
elements.append(
f'<line x1="{x}" y1="0" x2="{x}" y2="{hauteur}" '
f'stroke="{c[2]}" stroke-width="1" opacity="0.3"/>'
)
for y in range(0, hauteur, spacing):
elements.append(
f'<line x1="0" y1="{y}" x2="{largeur}" y2="{y}" '
f'stroke="{c[2]}" stroke-width="1" opacity="0.3"/>'
)
for _ in range(30):
cx = random.randint(0, largeur)
cy = random.randint(0, hauteur)
elements.append(
f'<circle cx="{cx}" cy="{cy}" r="{random.randint(3, 12)}" '
f'fill="{c[0]}" opacity="0.7"/>'
)

elif motif == "particles":
for _ in range(200):
cx = random.randint(0, largeur)
cy = random.randint(0, hauteur)
r = random.randint(1, 8)
elements.append(
f'<circle cx="{cx}" cy="{cy}" r="{r}" fill="{c[random.randint(0,3)]}" '
f'opacity="{random.uniform(0.3, 0.9):.2f}"/>'
)

elif motif == "hexagons":
size = random.randint(40, 100)
for row in range(0, hauteur + size, size):
for col in range(0, largeur + size, int(size * 1.732)):
offset = size // 2 if (row // size) % 2 else 0
x = col + offset
y = row
pts = " ".join([
f"{x + size*math.cos(math.radians(60*i))},"
f"{y + size*math.sin(math.radians(60*i))}"
for i in range(6)
])
elements.append(
f'<polygon points="{pts}" fill="none" stroke="{c[random.randint(0,3)]}" '
f'stroke-width="2" opacity="{random.uniform(0.2, 0.6):.2f}"/>'
)

elif motif == "mesh":
for i in range(50):
x1 = random.randint(0, largeur)
y1 = random.randint(0, hauteur)
x2 = random.randint(0, largeur)
y2 = random.randint(0, hauteur)
elements.append(
f'<line x1="{x1}" y1="{y1}" x2="{x2}" y2="{y2}" '
f'stroke="{c[random.randint(0,3)]}" stroke-width="{random.randint(1, 3)}" '
f'opacity="{random.uniform(0.1, 0.4):.2f}"/>'
)

# Ajout d'un halo Nexus
elements.append(
f'<circle cx="{largeur // 2}" cy="{hauteur // 2}" r="{min(largeur, hauteur) // 3}" '
f'fill="none" stroke="{c[0]}" stroke-width="3" opacity="0.4"/>'
)

svg = (
f'<svg xmlns="http://www.w3.org/2000/svg" width="{largeur}" height="{hauteur}" '
f'viewBox="0 0 {largeur} {hauteur}">'
+ "".join(elements) +
'</svg>'
)
return svg


def generer_bibliotheque(n=48):
"""Génère n wallpapers procéduraux."""
db = db_load()
if len(db["wallpapers"]) >= n:
return db["wallpapers"]

for i in range(n):
seed = random.randint(1, 999999)
palette = random.choice(PALETTES)
motif = random.choice(MOTIFS)
cat = random.choice(CATEGORIES)
nom_res, w, h = random.choice(RESOLUTIONS)

wid = hashlib.sha256(str(seed).encode()).hexdigest()[:16]

svg = generer_svg_wallpaper(seed, palette, motif, w, h)
path = os.path.join(WALLPAPERS, wid + ".svg")
try:
with open(path, "w", encoding="utf-8") as f:
f.write(svg)
except OSError:
continue

tags = list(set([
cat.lower(),
motif,
nom_res.lower(),
palette["nom"].split()[0].lower(),
random.choice(["dark", "light", "colorful", "minimal"]),
]))

wp = {
"id": wid,
"nom": f"{palette['nom']} — {motif.capitalize()}",
"categorie": cat,
"tags": tags,
"palette": palette["nom"],
"couleurs": palette["couleurs"],
"motif": motif,
"resolution": [w, h],
"resolution_label": nom_res,
"chemin": path,
"sha256": hashlib.sha256(svg.encode()).hexdigest()[:16],
"size": len(svg),
"created": datetime.datetime.now(datetime.timezone.utc).isoformat(),
"favori": False,
"purity": random.choice(["sfw", "sfw", "sfw", "sketchy"]),
}
db["wallpapers"].append(wp)

db["stats"]["total"] = len(db["wallpapers"])
db["stats"]["last_gen"] = datetime.datetime.now().isoformat()
db_save(db)
log("Bibliothèque générée : " + str(len(db["wallpapers"])) + " wallpapers")
return db["wallpapers"]


