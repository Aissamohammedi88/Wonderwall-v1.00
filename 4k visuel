<div class="logo">⚡ WonderWall</div>
<span class="version">v__VERSION__</span>
<div class="search">
<input id="q" type="text" placeholder="Rechercher un wallpaper…" autocomplete="off">
</div>
<button id="btn-fav" onclick="toggleFavFilter()">⭐ Favoris</button>
<button id="btn-gen" class="prim" onclick="generateMore()">✨ Générer</button>
</header>

<div class="layout">
<aside>
<div class="section">
<h3>Catégories</h3>
<div id="cats"></div>
</div>
<div class="section">
<h3>Palettes</h3>
<div id="palettes"></div>
</div>
<div class="section">
<h3>Résolutions</h3>
<div id="resolutions"></div>
</div>
</aside>

<main>
<div class="stats-bar" id="stats-bar"></div>
<div class="grid" id="grid"></div>
</main>
</div>

<div class="modal" id="modal" onclick="if(event.target.id==='modal')closeModal()">
<div class="box" id="modal-box"></div>
</div>

<footer>
<div class="dot"></div>
<span id="status">Chargement…</span>
<span class="spacer"></span>
<span>Auteur : <b>Aissa Mohammedi (DGK)</b></span>
<span>·</span>
<span>NEXUS-OPEN-2.0</span>
<span>·</span>
<span id="total-count">0</span>
</footer>

<script>
// ═══════════════════════════════════════════════════════════════════════════
// ÉTAT GLOBAL
// ═══════════════════════════════════════════════════════════════════════════
let STATE = {
all: [],
filtered: [],
filterCat: null,
filterPalette: null,
filterRes: null,
filterFav: false,
search: "",
currentModal: null,
};

// ═══════════════════════════════════════════════════════════════════════════
// UTILS
// ═══════════════════════════════════════════════════════════════════════════
function esc(s) {
const d = document.createElement('div');
d.textContent = (s === null || s === undefined) ? '' : String(s);
return d.innerHTML;
}
function fmtSize(b) {
if (b < 1024) return b + ' o';
if (b < 1048576) return (b / 1024).toFixed(1) + ' Ko';
return (b / 1048576).toFixed(1) + ' Mo';
}

// ═══════════════════════════════════════════════════════════════════════════
// API
// ═══════════════════════════════════════════════════════════════════════════
async function api_get(url) {
try {
const r = await fetch(url);
return await r.json();
} catch (e) {
return { ok: false, err: e.message };
}
}
async function api_post(url, body) {
try {
const r = await fetch(url, {
method: 'POST',
headers: { 'Content-Type': 'application/json' },
body: JSON.stringify(body || {}),
});
return await r.json();
} catch (e) {
return { ok: false, err: e.message };
}
}

// ═══════════════════════════════════════════════════════════════════════════
// CHARGEMENT
// ═══════════════════════════════════════════════════════════════════════════
async function loadLibrary() {
document.getElementById('status').textContent = 'Chargement…';
const r = await api_get('/api/library');
if (!r.ok) {
document.getElementById('status').textContent = 'Erreur : ' + (r.err || '?');
return;
}
STATE.all = r.wallpapers || [];
STATE.total = r.total || STATE.all.length;
buildSidebar();
applyFilters();
document.getElementById('status').textContent = 'Prêt';
}

async function generateMore() {
document.getElementById('status').textContent = 'Génération…';
const r = await api_post('/api/generate', { n: 24 });
if (r.ok) {
document.getElementById('status').textContent = 'Généré ' + r.added + ' nouveaux';
await loadLibrary();
} else {
document.getElementById('status').textContent = 'Erreur génération';
}
}

// ═══════════════════════════════════════════════════════════════════════════
// SIDEBAR
// ═══════════════════════════════════════════════════════════════════════════
function buildSidebar() {
// Catégories
const cats = {};
STATE.all.forEach(w => { cats[w.categorie] = (cats[w.categorie] || 0) + 1; });
const catsEl = document.getElementById('cats');
catsEl.innerHTML = '<div class="item" onclick="setFilter(\'cat\',null)">'
+ 'Toutes <span class="count">' + STATE.all.length + '</span></div>'
+ Object.entries(cats).sort((a,b) => b[1] - a[1]).map(([k, v]) =>
'<div class="item ' + (STATE.filterCat === k ? 'on' : '') +
'" onclick="setFilter(\'cat\',\'' + esc(k) + '\')">' +
esc(k) + ' <span class="count">' + v + '</span></div>'
).join('');

// Palettes
const pals = {};
STATE.all.forEach(w => { pals[w.palette] = (pals[w.palette] || 0) + 1; });
const palsEl = document.getElementById('palettes');
palsEl.innerHTML = Object.entries(pals).sort((a,b) => b[1] - a[1]).map(([k, v]) => {
const wp = STATE.all.find(w => w.palette === k);
const c = wp ? wp.couleurs[0] : '#00d4ff';
return '<div class="item ' + (STATE.filterPalette === k ? 'on' : '') +
'" onclick="setFilter(\'palette\',\'' + esc(k) + '\')">' +
'<span><span class="color" style="background:' + c + ';display:inline-block;margin-right:8px"></span>' +
esc(k) + '</span> <span class="count">' + v + '</span></div>';
}).join('');

// Résolutions
const ress = {};
STATE.all.forEach(w => { ress[w.resolution_label] = (ress[w.resolution_label] || 0) + 1; });
const ressEl = document.getElementById('resolutions');
ressEl.innerHTML = Object.entries(ress).sort((a,b) => b[1] - a[1]).map(([k, v]) =>
'<div class="item ' + (STATE.filterRes === k ? 'on' : '') +
'" onclick="setFilter(\'res\',\'' + esc(k) + '\')">' +
esc(k) + ' <span class="count">' + v + '</span></div>'
).join('');
}

function setFilter(type, value) {
if (type === 'cat') STATE.filterCat = (STATE.filterCat === value) ? null : value;
if (type === 'palette') STATE.filterPalette = (STATE.filterPalette === value) ? null : value;
if (type === 'res') STATE.filterRes = (STATE.filterRes === value) ? null : value;
buildSidebar();
applyFilters();
}

function toggleFavFilter() {
STATE.filterFav = !STATE.filterFav;
document.getElementById('btn-fav').style.background =
STATE.filterFav ? 'linear-gradient(135deg,#ff6ec7,#a855f7)' : '';
document.getElementById('btn-fav').style.color = STATE.filterFav ? '#000' : '';
applyFilters();
}

// ═══════════════════════════════════════════════════════════════════════════
// FILTRES
// ═══════════════════════════════════════════════════════════════════════════
function applyFilters() {
let list = STATE.all.slice();

if (STATE.filterCat) list = list.filter(w => w.categorie === STATE.filterCat);
if (STATE.filterPalette) list = list.filter(w => w.palette === STATE.filterPalette);
if (STATE.filterRes) list = list.filter(w => w.resolution_label === STATE.filterRes);
if (STATE.filterFav) list = list.filter(w => w.favori);

if (STATE.search) {
const q = STATE.search.toLowerCase();
list = list.filter(w =>
w.nom.toLowerCase().includes(q) ||
w.categorie.toLowerCase().includes(q) ||
w.motif.toLowerCase().includes(q) ||
w.tags.some(t => t.includes(q))
);
}

STATE.filtered = list;
render();
}

// ═══════════════════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════════════════
function render() {
const grid = document.getElementById('grid');
const sb = document.getElementById('stats-bar');

sb.innerHTML =
'<div class="stat"><span class="k">Total</span><span class="v">' + STATE.total + '</span></div>' +
'<div class="stat"><span class="k">Affichés</span><span class="v">' + STATE.filtered.length + '</span></div>' +
'<div class="stat"><span class="k">Favoris</span><span class="v">' + STATE.all.filter(w => w.favori).length + '</span></div>' +
'<div class="stat"><span class="k">Catégories</span><span class="v">' + new Set(STATE.all.map(w => w.categorie)).size + '</span></div>' +
'<div class="stat"><span class="k">Palettes</span><span class="v">' + new Set(STATE.all.map(w => w.palette)).size + '</span></div>';

document.getElementById('total-count').textContent = STATE.total + ' wallpapers';

if (STATE.filtered.length === 0) {
grid.innerHTML = '<div class="empty" style="grid-column:1/-1">' +
'<div class="big">🌌</div>Aucun wallpaper avec ces filtres.<br>' +
'<button class="prim" onclick="generateMore()" style="margin-top:16px;padding:10px 20px;border-radius:9px;border:none;background:linear-gradient(135deg,#00d4ff,#a855f7);color:#000;font-weight:700;cursor:pointer">✨ Générer plus</button>' +
'</div>';
return;
}

grid.innerHTML = STATE.filtered.map(w => {
const purityClass = 'purity-' + (w.purity || 'sfw');
const favClass = w.favori ? 'on' : '';
return '<div class="card" onclick="openModal(\'' + w.id + '\')">' +
'<div class="thumb">' +
'<img src="/wallpaper/' + w.id + '" alt="' + esc(w.nom) + '" loading="lazy">' +
'<div class="badges">' +
'<span class="badge">' + esc(w.resolution_label) + '</span>' +
'<span class="badge ' + purityClass + '">' + esc(w.purity) + '</span>' +
'</div>' +
'<div class="fav ' + favClass + '" onclick="event.stopPropagation();toggleFav(\'' + w.id + '\')">' +
(w.favori ? '★' : '☆') +
'</div>' +
'</div>' +
'<div class="meta">' +
'<h4>' + esc(w.nom) + '</h4>' +
'<div class="res">' + w.resolution[0] + '×' + w.resolution[1] + ' · ' + fmtSize(w.size) + '</div>' +
'<div class="row">' +
w.tags.slice(0, 4).map(t =>
'<span class="tag" onclick="event.stopPropagation();searchTag(\'' + esc(t) + '\')">#' + esc(t) + '</span>'
).join('') +
'</div>' +
'</div>' +
'</div>';
}).join('');
}

function searchTag(tag) {
STATE.search = tag;
document.getElementById('q').value = tag;
applyFilters();
}

// ═══════════════════════════════════════════════════════════════════════════
// FAVORIS
// ═══════════════════════════════════════════════════════════════════════════
async function toggleFav(id) {
const r = await api_post('/api/fav', { id: id });
if (r.ok) {
const wp = STATE.all.find(w => w.id === id);
if (wp) wp.favori = r.favori;
applyFilters();
if (STATE.currentModal === id) openModal(id);
}
}

// ═══════════════════════════════════════════════════════════════════════════
// MODAL
// ═══════════════════════════════════════════════════════════════════════════
function openModal(id) {
const w = STATE.all.find(x => x.id === id);
if (!w) return;
STATE.currentModal = id;

const box = document.getElementById('modal-box');
box.innerHTML =
'<div class="preview">' +
'<img src="/wallpaper/' + w.id + '" alt="' + esc(w.nom) + '">' +
'<button class="close" onclick="closeModal()">✕</button>' +
'</div>' +
'<div class="info">' +
'<h2>' + esc(w.nom) + '</h2>' +
'<div class="spec">' +
'<b>ID :</b> ' + esc(w.id) + '<br>' +
'<b>Catégorie :</b> ' + esc(w.categorie) + '<br>' +
'<b>Palette :</b> ' + esc(w.palette) + '<br>' +
'<b>Motif :</b> ' + esc(w.motif) + '<br>' +
'<b>Résolution :</b> ' + w.resolution[0] + '×' + w.resolution[1] + ' (' + esc(w.resolution_label) + ')<br>' +
'<b>Taille :</b> ' + fmtSize(w.size) + '<br>' +
'<b>SHA-256 :</b> ' + esc(w.sha256) + '<br>' +
'<b>Purity :</b> ' + esc(w.purity) + '<br>' +
'<b>Créé :</b> ' + esc(w.created.slice(0, 19).replace('T', ' ')) +
'</div>' +
'<div class="tags">' +
w.tags.map(t => '<span class="tag" onclick="searchTag(\'' + esc(t) + '\');closeModal()">#' + esc(t) + '</span>').join('') +
'</div>' +
'<div class="actions">' +
'<button class="prim" onclick="downloadWallpaper(\'' + w.id + '\')">⬇ Télécharger</button>' +
'<button onclick="toggleFav(\'' + w.id + '\')">' + (w.favori ? '★ Retirer' : '☆ Favori') + '</button>' +
'<button onclick="copyUrl(\'' + w.id + '\')">🔗 Copier URL</button>' +
'<button onclick="closeModal()">Fermer</button>' +
'</div>' +
'</div>';

document.getElementById('modal').classList.add('on');
}

function closeModal() {
document.getElementById('modal').classList.remove('on');
STATE.currentModal = null;
}

function downloadWallpaper(id) {
window.location.href = '/download/' + id;
}

function copyUrl(id) {
const url = window.location.origin + '/wallpaper/' + id;
navigator.clipboard.writeText(url).then(() => {
document.getElementById('status').textContent = 'URL copiée';
setTimeout(() => document.getElementById('status').textContent = 'Prêt', 1500);
});
}

// ═══════════════════════════════════════════════════════════════════════════
// RECHERCHE
// ═══════════════════════════════════════════════════════════════════════════
document.getElementById('q').addEventListener('input', (e) => {
STATE.search = e.target.value.trim();
applyFilters();
});

// ESC ferme la modal
document.addEventListener('keydown', (e) => {
if (e.key === 'Escape') closeModal();
});

// ═══════════════════════════════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════════════════════════════
loadLibrary();
</script>
</body>
</html>
"""


# ═══════════════════════════════════════════════════════════════════════════
# SERVEUR HTTP
# ═══════════════════════════════════════════════════════════════════════════

class Handler(BaseHTTPRequestHandler):
server_version = "WonderWall/" + VERSION
protocol_version = "HTTP/1.1"

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8", extra=None):
if isinstance(body, str):
body = body.encode("utf-8")
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Cache-Control", "no-store")
if extra:
for k, v in extra.items():
self.send_header(k, v)
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code, obj):
self._send(code, json.dumps(obj, indent=2, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

def do_GET(self):
p = urllib.parse.urlparse(self.path)
path = p.path

if path in ("/", "/index.html"):
html = HTML.replace("__VERSION__", VERSION)
return self._send(200, html)

if path == "/api/library":
db = db_load()
return self._json(200, {
"ok": True,
"total": len(db["wallpapers"]),
"wallpapers": db["wallpapers"],
})

if path.startswith("/wallpaper/"):
wid = path.split("/")[-1]
wid = re.sub(r"[^a-f0-9]", "", wid)[:16]
if not wid:
return self._send(404, "404")
fp = os.path.join(WALLPAPERS, wid + ".svg")
if not os.path.isfile(fp):
return self._send(404, "404")
try:
with open(fp, "r", encoding="utf-8") as f:
content = f.read()
return self._send(200, content, "image/svg+xml")
except OSError:
return self._send(500, "500")

if path.startswith("/download/"):
wid = path.split("/")[-1]
wid = re.sub(r"[^a-f0-9]", "", wid)[:16]
if not wid:
return self._send(404, "404")
fp = os.path.join(WALLPAPERS, wid + ".svg")
if not os.path.isfile(fp):
return self._send(404, "404")
try:
with open(fp, "rb") as f:
content = f.read()
return self._send(
200, content, "image/svg+xml",
{"Content-Disposition": 'attachment; filename="wonderwall-' + wid + '.svg"'}
)
except OSError:
return self._send(500, "500")

if path == "/api/status":
db = db_load()
return self._json(200, {
"ok": True,
"service": "WonderWall",
"version": VERSION,
"auteur": AUTEUR,
"licence": LICENCE,
"port": PORT,
"total": len(db["wallpapers"]),
"base": BASE,
"uptime_s": int(time.time() - START_TS),
})

if path == "/ping":
return self._send(200, "pong")

return self._send(404, "404 — Not found")

def do_POST(self):
p = urllib.parse.urlparse(self.path)
path = p.path

try:
length = int(self.headers.get("Content-Length", "0") or "0")
body = self.rfile.read(length).decode("utf-8", "ignore") if length else "{}"
payload = json.loads(body)
except Exception:
payload = {}

if path == "/api/generate":
n = int(payload.get("n", 24))
before = len(db_load()["wallpapers"])
generer_bibliotheque(before + n)
after = len(db_load()["wallpapers"])
return self._json(200, {"ok": True, "added": after - before, "total": after})

if path == "/api/fav":
wid = re.sub(r"[^a-f0-9]", "", payload.get("id", ""))[:16]
db = db_load()
for w in db["wallpapers"]:
if w["id"] == wid:
w["favori"] = not w.get("favori", False)
db_save(db)
return self._json(200, {"ok": True, "favori": w["favori"]})
return self._json(404, {"ok": False, "err": "introuvable"})

return self._json(404, {"ok": False, "err": "not found"})


class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True


# ═══════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════

START_TS = time.time()


def port_libre(port):
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
s.settimeout(0.5)
s.bind(("127.0.0.1", port))
return True
except OSError:
return False
finally:
try: s.close()
except Exception: pass


def ip_lan():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]
s.close()
return ip
except Exception:
return "127.0.0.1"


def main():
print()
print("=" * 74)
print(" ⚡ NEXUS WONDERWALL v" + VERSION)
print(" Auteur : " + AUTEUR + " | Licence : " + LICENCE)
print("=" * 74)
print()
print(" Wallpaper manager local — génération procédurale Python")
print(" Bibliothèque : " + BASE)
print()

db = db_load()
if not db["wallpapers"]:
print(" 🎨 Première génération de 48 wallpapers…")
generer_bibliotheque(48)
db = db_load()
print(" ✅ Bibliothèque : " + str(len(db["wallpapers"])) + " wallpapers")
print()

port = PORT
if not port_libre(port):
for p in range(port + 1, port + 20):
if port_libre(p):
port = p
break
print(" ⚠️ Port " + str(PORT) + " occupé → " + str(port))
print()

print(" 🌐 Local : http://localhost:" + str(port) + "/")
print(" 🌐 Réseau : http://" + ip_lan() + ":" + str(port) + "/")
print()
print(" 📡 API :")
print(" GET /api/library")
print(" GET /api/status")
print(" POST /api/generate {n}")
print(" POST /api/fav {id}")
print(" GET /wallpaper/<id>")
print(" GET /download/<id>")
print()
print(" Ctrl+C pour arrêter")
print()

log("=== NEXUS WONDERWALL v" + VERSION + " ===")
log("Port : " + str(port))

try:
srv = Server(("0.0.0.0", port), Handler)
log("Serveur prêt")
srv.serve_forever()
except KeyboardInterrupt:
print()
print(" Arrêté.")
print()
except OSError as e:
print(" Erreur port " + str(port) + " : " + str(e))


if __name__ == "__main__":
try:
main()
except Exception as e:
print(" ERREUR FATALE : " + str(e))
