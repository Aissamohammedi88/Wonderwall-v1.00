def log(msg):
ts = time.strftime("%Y-%m-%d %H:%M:%S")
line = "[" + ts + "] " + str(msg)
try: print(line, flush=True)
except: pass
with LOG_LK:
try:
with open(LOG_FILE, "a", encoding="utf-8") as f:
f.write(line + "\n")
except OSError:
pass


